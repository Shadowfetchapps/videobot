#!/bin/bash
# VideoBot launcher
# Finder strips the shell environment, so we resolve paths and inject
# the user site-packages directory explicitly before importing anything.

APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"

# ── Find Python 3 ─────────────────────────────────────────────────────────────
PYTHON=""
for candidate in \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    "$HOME/.pyenv/shims/python3" \
    /usr/bin/python3; do
    if [ -x "$candidate" ]; then
        PYTHON="$candidate"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    osascript -e 'display alert "VideoBot" message "Python 3 not found.\n\nInstall Python from https://python.org and then run:\n\npip3 install -r requirements.txt\nplaywright install chromium"'
    exit 1
fi

# ── Inject user site-packages so Finder-launched apps can find pip packages ──
PYVER=$("$PYTHON" -c "import sys; v=sys.version_info; print(str(v.major)+'.'+str(v.minor))" 2>/dev/null)
USER_SITE="$HOME/Library/Python/$PYVER/lib/python/site-packages"
if [ -d "$USER_SITE" ]; then
    export PYTHONPATH="$USER_SITE${PYTHONPATH:+:$PYTHONPATH}"
fi

# ── Sanity check ──────────────────────────────────────────────────────────────
if ! "$PYTHON" -c "import PyQt6" 2>/dev/null; then
    osascript -e "display alert \"VideoBot — Missing Dependencies\" message \"PyQt6 is not installed.\n\nOpen Terminal and run:\n\npip3 install -r $APP_DIR/requirements.txt\nplaywright install chromium\""
    exit 1
fi

cd "$APP_DIR"
exec "$PYTHON" "$APP_DIR/run.py"
